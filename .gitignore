__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# 本地密钥与运行时数据（禁止入库）
.env
.env.*
!.env.example
*.pem
*.key
data/
logs/
*.log
*.db
*.sqlite3

# 备份产物与临时目录（只忽略仓库根，deploy/backup/ 是随仓库分发的脚本）
/backup/
/tmp/

# 部署产物（Compose / Ansible）：真实密钥与运行数据禁止入库
deploy/compose/.env
deploy/compose/data/
deploy/compose/restore/
deploy/ansible/inventory.ini
deploy/ansible/group_vars/all.yml
deploy/ansible/*.retry
deploy/compose/*.log
