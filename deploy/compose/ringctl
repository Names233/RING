#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# ringctl — RING 部署控制台（Docker Compose 路径的统一入口）
#
#   ./ringctl up [core|ring|edge|all]   启动（默认 all：core+ring+edge）
#   ./ringctl down [--volumes]          停止（--volumes 会删除数据卷，慎用）
#   ./ringctl restart <服务名>          重启单个服务
#   ./ringctl ps / logs [服务名]         状态 / 日志
#   ./ringctl build / pull              构建镜像 / 拉取上游镜像
#   ./ringctl upgrade                   拉新镜像 → 重建 → 打印回滚方法
#   ./ringctl doctor                    体检（docker、配置、端口、健康）
#   ./ringctl backup                    立刻备份一次（加密 → 本地 spool → WebDAV）
#   ./ringctl restore <归档文件> [目录]   解密解包到目录（默认 ./restore）
#   ./ringctl shell <服务名>            进容器（默认 sh）
#   ./ringctl config                    渲染后的 compose 配置（排错用）
#
# 环境：本目录下的 .env。缺 .env 时先跑 ./ring-init.sh
# ---------------------------------------------------------------------------
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$HERE"

ENV_FILE="$HERE/.env"
COMPOSE_FILE="$HERE/docker-compose.yml"

if [ -t 1 ]; then
  C_INFO=$'\033[32m'; C_WARN=$'\033[33m'; C_ERR=$'\033[31m'; C_OFF=$'\033[0m'
else
  C_INFO=''; C_WARN=''; C_ERR=''; C_OFF=''
fi
info() { printf '%s==>%s %s\n' "$C_INFO" "$C_OFF" "$*"; }
warn() { printf '%s[!]%s %s\n' "$C_WARN" "$C_OFF" "$*"; }
bad()  { printf '%s[x]%s %s\n' "$C_ERR" "$C_OFF" "$*"; }
die()  { bad "$*"; exit 1; }

if [ ! -f "$ENV_FILE" ]; then
  die "缺少 .env：先运行 ./ring-init.sh（或 cp .env.example .env 后手动填写）"
fi

if docker compose version >/dev/null 2>&1; then
  COMPOSE="docker compose"
elif command -v docker-compose >/dev/null 2>&1; then
  COMPOSE="docker-compose"
else
  die "未找到 docker compose / docker-compose"
fi

dc() { $COMPOSE -f "$COMPOSE_FILE" --env-file "$ENV_FILE" "$@"; }

load_env() {
  # 逐行解析 KEY=VALUE，避免 .env 里含空格的值被 shell 当成命令执行
  # （例如 BACKUP_PATHS=openviking maibot ... 直接 source 会报 command not found）
  local line key val
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    case "$line" in *=*) ;; *) continue ;; esac
    key="${line%%=*}"
    val="${line#*=}"
    case "$key" in *[!A-Za-z0-9_]*) continue ;; esac
    case "$val" in
      \"*\") val="${val#\"}"; val="${val%\"}" ;;
      \'*\') val="${val#\'}"; val="${val%\'}" ;;
    esac
    export "$key=$val"
  done < "$ENV_FILE"
}

usage() { sed -n '2,22p' "$0" | sed -e 's/^# \{0,1\}//'; }

cmd_up() {
  local target="${1:-all}"
  if [ "$#" -gt 0 ]; then shift; fi
  local profiles
  case "$target" in
    core) profiles="--profile core" ;;
    ring) profiles="--profile core --profile ring" ;;
    edge|all) profiles="--profile core --profile ring --profile edge" ;;
    *) die "未知目标：$target（core / ring / edge / all）" ;;
  esac
  info "启动 [$target]"
  # shellcheck disable=SC2086
  dc $profiles up -d "$@"
  dc ps
}

cmd_down() {
  local volumes=""
  for a in "$@"; do
    case "$a" in
      --volumes|-v) volumes="--volumes" ;;
    esac
  done
  if [ -n "$volumes" ]; then
    warn "将删除容器与数据卷（bind 挂载的 RING_DATA_DIR 不受影响）"
  fi
  dc --profile core --profile ring --profile edge --profile backup down $volumes
}

cmd_logs() {
  if [ "$#" -gt 0 ]; then
    dc logs -f --tail=200 "$@"
  else
    dc logs -f --tail=120
  fi
}

cmd_upgrade() {
  load_env
  info "1/3 拉取上游镜像（napcat/caddy）"
  dc --profile core --profile edge pull napcat caddy || warn "拉取失败，继续用本地镜像"
  info "2/3 重建自研镜像"
  dc --profile core --profile ring --profile backup build
  info "3/3 滚动重建"
  dc --profile core --profile ring --profile edge up -d
  dc ps
  cat <<'EOF'

回滚方法：镜像 tag 由 .env 的 MAIBOT_VERSION / OPENVIKING_VERSION / RING_IMAGE_TAG 决定。
  1) 把版本号改回旧值：编辑 .env
  2) ./ringctl up all --force-recreate
数据在 RING_DATA_DIR 里，不回滚数据；如需还原数据用 ./ringctl restore <归档>
EOF
}

cmd_backup() {
  load_env
  info "执行一次备份"
  dc --profile backup run --rm --no-deps backup
  info "本地留存：${RING_DATA_DIR}/backup/spool"
}

cmd_restore() {
  load_env
  local archive="${1:-}"
  local target="${2:-$HERE/restore}"
  [ -n "$archive" ] || die "用法：./ringctl restore <归档文件名> [解包目录]"
  mkdir -p "$target"
  local spool="${RING_DATA_DIR:-./data}/backup/spool"
  if [ -f "$archive" ]; then
    spool="$(cd "$(dirname "$archive")" && pwd)"
    archive="$(basename "$archive")"
  fi
  [ -f "$spool/$archive" ] || die "找不到归档：$spool/$archive（先 scp 到 spool 目录或传绝对路径）"
  info "解密解包 $archive → $target"
  dc --profile backup run --rm --no-deps \
    -v "$spool:/spool:ro" \
    -v "$target:/restore" \
    backup /usr/local/bin/ring-restore.sh "/spool/$archive" /restore
  info "已解包到 $target（不会自动覆盖运行中的数据）"
}

cmd_doctor() {
  load_env
  local fail=0
  echo "RING 体检  $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  echo "-----------------------------------------------------------"

  if docker info >/dev/null 2>&1; then
    info "docker daemon           OK ($(docker --version | awk '{print $3}' | tr -d ,))"
  else
    bad "docker daemon           无法访问（当前用户不在 docker 组？）"; fail=$((fail+1))
  fi

  if $COMPOSE version >/dev/null 2>&1; then
    info "compose                 OK ($($COMPOSE version --short 2>/dev/null || echo v1))"
  else
    bad "compose                 不可用"; fail=$((fail+1))
  fi

  if dc config >/dev/null 2>&1; then
    info "compose 配置            可解析"
  else
    bad "compose 配置            解析失败：运行 ./ringctl config 看报错"; fail=$((fail+1))
  fi

  local placeholders
  placeholders="$(grep -c '__CHANGE_ME__' "$ENV_FILE" || true)"
  if [ "${placeholders:-0}" -gt 0 ]; then
    warn ".env 中仍有 $placeholders 个 __CHANGE_ME__ 占位符（不影响启动，但功能会缺失）"
  else
    info ".env                    无占位符残留"
  fi

  if [ -f "${RING_DATA_DIR:-./data}/openviking/ov.conf" ]; then
    info "ov.conf                 存在（权限 $(stat -c '%a' "${RING_DATA_DIR}/openviking/ov.conf" 2>/dev/null || echo '?')）"
  else
    bad "ov.conf                 缺失：${RING_DATA_DIR}/openviking/ov.conf"; fail=$((fail+1))
  fi

  if [ -f "${RING_DATA_DIR:-./data}/backup/passphrase" ]; then
    info "备份口令                存在"
  else
    warn "备份口令                缺失：备份会失败（重跑 ring-init.sh 生成）"
  fi

  if [ -f "${RING_DATA_DIR:-./data}/caddy/Caddyfile" ]; then
    info "Caddyfile               存在"
  else
    warn "Caddyfile               缺失：edge profile 起不来"
  fi

  local mem_avail
  mem_avail="$(awk '/MemTotal/{print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 0)"
  if [ "${mem_avail}" -gt 0 ] && [ "${mem_avail}" -lt 3800 ]; then
    warn "内存 ${mem_avail}MB：低于 4G 时请只跑 core profile，或保证有 swap"
  fi

  echo "-----------------------------------------------------------"
  if dc ps >/dev/null 2>&1; then
    dc ps
    echo "-----------------------------------------------------------"
    local unhealthy
    unhealthy="$(dc ps --format '{{.Name}} {{.Health}}' 2>/dev/null | grep -v -E 'healthy$|^$' || true)"
    if [ -n "$unhealthy" ]; then
      warn "以下服务未健康："
      echo "$unhealthy"
    fi
    local ovport port code
    ovport="${OV_PORT:-1933}"
    for port in "$ovport" "${RING_OV_SERVICE_PORT:-18080}" "${RING_PERSONA_PORT:-18081}" "${RING_ROUTER_PORT:-18082}" "${MAIBOT_WEBUI_PORT:-8001}"; do
      if command -v curl >/dev/null 2>&1; then
        code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 "http://127.0.0.1:$port/health" || true)"
        [ -z "$code" ] && code="000"
        if [ "$code" = "200" ]; then info "端口 $port            /health 200"; else warn "端口 $port            /health $code"; fi
      fi
    done
  fi

  echo "-----------------------------------------------------------"
  if [ "$fail" -gt 0 ]; then
    bad "体检发现 $fail 个致命问题"; exit 1
  fi
  info "体检通过"
}

cmd_shell() {
  local svc="${1:-}"
  [ -n "$svc" ] || die "用法：./ringctl shell <服务名>"
  shift
  dc exec "$svc" "${@:-sh}" 2>/dev/null || dc run --rm --entrypoint sh "$svc"
}

cmd="${1:-}"
[ -n "$cmd" ] || { usage; exit 2; }
shift || true

case "$cmd" in
  up) cmd_up "$@" ;;
  down) cmd_down "$@" ;;
  restart) [ "$#" -gt 0 ] || die "用法：./ringctl restart <服务名>"; dc restart "$@" && dc ps ;;
  ps|status) dc ps ;;
  logs) cmd_logs "$@" ;;
  build) dc --profile core --profile ring --profile backup build "$@" ;;
  pull) dc --profile core --profile edge pull "$@" ;;
  upgrade) cmd_upgrade ;;
  doctor) cmd_doctor ;;
  backup) cmd_backup ;;
  restore) cmd_restore "$@" ;;
  shell|exec) cmd_shell "$@" ;;
  config) dc config ;;
  profiles) dc config --profiles ;;
  stop) dc --profile core --profile ring --profile edge stop ;;
  start) dc --profile core --profile ring --profile edge start ;;
  -h|--help|help) usage ;;
  *) usage; die "未知子命令：$cmd" ;;
esac
