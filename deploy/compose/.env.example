# =============================================================================
# RING Docker Compose 配置模板
#   cp .env.example .env   （或用 ./ring-init.sh 交互生成，含随机密钥）
# 所有值都可留空使用默认值，但 OV_* 的模型密钥与 AGT_* 必须填对才有真正对话能力。
# 本文件不含任何真实密钥；.env 已在 .gitignore 中。
# =============================================================================

# ---- 基础 ----
TZ=Asia/Shanghai
# 数据根目录：所有持久化数据都在这下面（相对路径按 compose 文件所在目录解析）
RING_DATA_DIR=./data
# 自研镜像 tag（ring-cloud / backup）
RING_IMAGE_TAG=0.1.0

# ---- 宿主端口（全部只绑 127.0.0.1，改端口不影响容器内部）----
OV_PORT=1933
MAIBOT_WEBUI_PORT=8001
MAIBOT_WS_PORT=8000
MAIBOT_API_PORT=8090
NAPCAT_ONEBOT_PORT=3001
NAPCAT_WEBUI_PORT=6099
RING_OV_SERVICE_PORT=18080
RING_PERSONA_PORT=18081
RING_ROUTER_PORT=18082

# ---- edge profile：Caddy 反代 + 自动 TLS ----
# 两个域名都要提前解析到本机公网 IP；本机 80/443 必须空闲。
OV_DOMAIN=ov.example.com
MB_DOMAIN=mb.example.com
ACME_EMAIL=you@example.com

# ---- 组件版本（钉死，避免漂移）----
MAIBOT_VERSION=1.3.19
OPENVIKING_VERSION=0.5.3
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest
CADDY_IMAGE=caddy:2-alpine

# ---- 内存上限（与生产 systemd MemoryMax 对齐；2G 机器不要再调大）----
OV_MEM_LIMIT=640M
MAIBOT_MEM_LIMIT=700M
NAPCAT_MEM_LIMIT=1200M
RINGCLOUD_MEM_LIMIT=180M
BACKUP_MEM_LIMIT=256M

# ---- OpenViking 服务端 ----
# root_api_key：OV 的管理密钥，也是 MaiBot 读写记忆用的密钥（单用户部署可复用同一个值）
OV_ROOT_API_KEY=__CHANGE_ME__
OV_USER_API_KEY=__CHANGE_ME__
# 向量化模型（OpenAI 兼容接口；可指向 DashScope / 火山 Ark / 本地 vLLM）
OV_EMBEDDING_MODEL=qwen3-text-embedding
OV_EMBEDDING_API_KEY=__CHANGE_ME__
OV_EMBEDDING_API_BASE=https://your-embedding-endpoint/v1
OV_EMBEDDING_DIMENSION=1024
# 重排模型（可留空 api_key 表示不用，但 OV 0.5.3 的 rerank 段仍需存在）
OV_RERANK_MODEL=qwen3-text-rerank
OV_RERANK_API_KEY=__CHANGE_ME__
OV_RERANK_API_BASE=https://your-rerank-endpoint/api/v1/services/rerank/text-rerank
OV_RERANK_THRESHOLD=0.1
# 视觉模型（图片/文档理解，仅 OV 的 vlm 链路使用）
OV_VLM_MODEL=gemini-3.8-flash
OV_VLM_API_KEY=__CHANGE_ME__
OV_VLM_API_BASE=https://your-vlm-endpoint/v1
OV_VLM_TEMPERATURE=0.0
OV_VLM_MAX_TOKENS=4096

# ---- MaiBot ----
# 容器内访问 OV 的服务名地址（不要改成 127.0.0.1）
OPENVIKING_BASE_URL=http://openviking:1933
# 可选：口令文件路径（容器内可读即可）；留空表示用 OPENVIKING_API_KEY
OPENVIKING_API_KEY_FILE=
# 1 = 每次启动都按环境变量重写 data/openviking.json（默认 0，只补缺）
RING_OV_CONFIG_FORCE=0

# ---- ring-cloud（自研三服务）----
# 心跳/内部调用鉴权；不填则 ring_router 不校验（仅本机回环时可用）
HEARTBEAT_SECRET_TOKEN=__CHANGE_ME__
# 模型网关：宿主机上的网关用 host.docker.internal；云网关直接填 https URL
AGT_BASE_URL=http://host.docker.internal:8045/v1
AGT_API_KEY=__CHANGE_ME__
AGT_MODEL=gemini-3.8-flash
AGT_TIMEOUT_SECONDS=20.0
# 1 = 完全离线（不调用外部模型，路由退回规则分类）
RING_OFFLINE_MODE=0
# 可选：ACP bridge / AIRI 不在本 compose 内，默认指向不存在端口即可
ACP_BRIDGE_URL=http://127.0.0.1:18090
AIRI_EMBODIMENT_URL=http://127.0.0.1:18092

# ---- NapCat ----
# 容器内 UID/GID，需与 RING_DATA_DIR 属主一致（否则 QQ 登录态写不进去）
NAPCAT_UID=1000
NAPCAT_GID=1000

# ---- 备份（backup profile）----
# 备份哪些子目录（相对 RING_DATA_DIR）
BACKUP_PATHS="openviking maibot napcat/config caddy"
# 远端保留份数
BACKUP_KEEP=14
# WebDAV 目的地；DAV_BASE 留空 = 只备份到本地 spool
DAV_BASE=
DAV_USER=
DAV_PASS=
